VITE_SIMPLE_BOT_PROVIDER_ENDPOINT=
VITE_MARKDOWN_BOT_PROVIDER_ENDPOINT=
VITE_PRIVATE_BOT_PROVIDER_ENDPOINT=
VITE_CONSENT_BOT_PROVIDER_ENDPOINT=
VITE_CONSENT_API_KEY=
VITE_API_KEY=
VITE_CHANNEL_HOME_BOT_PROVIDER_ENDPOINT=

# SourceSet File Explorer (/source-set-explorer).
# Leave the endpoint blank to run the route against its built-in in-memory volume — every action works
# without credentials. Set it to point both mounts at a real volume instead, e.g.
#   {EDGE}/ns/{namespace}/source-set/{name}/volume        with VITE_SOURCE_SET_API_KEY
#   {PLATFORM_API}/v1/source-set/{source_set_id}/volume   with VITE_SOURCE_SET_AUTH_TOKEN
# Give it one or the other: a BFF relay holds the volume key itself and must not be sent an api key.
VITE_SOURCE_SET_ENDPOINT=
VITE_SOURCE_SET_API_KEY=
VITE_SOURCE_SET_AUTH_TOKEN=
